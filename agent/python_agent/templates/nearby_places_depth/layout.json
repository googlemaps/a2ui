[
  {
    "version": "v0.9",
    "createSurface": {
      "surfaceId": "{{surface_id}}",
      "catalogId": "{{catalog_id}}"
    }
  },
  {
    "version": "v0.9",
    "updateComponents": {
      "surfaceId": "{{surface_id}}",
      "components": [
        {
          "id": "root",
          "component": "List",
          "direction": "vertical",
          "children": ["preamble-text", "map", "list"]
        },
        {
          "id": "preamble-text",
          "component": "Text",
          "variant": "body",
          "text": "{{preamble}}"
        },
        {
          "id": "map",
          "component": "GoogleMap",
          "tilt": 0,
          "mode": "roadmap",
          "anchorMarker": "{{anchor_marker}}",
          "markers": "{{markers}}"
        },
        {
          "id": "list",
          "component": "List",
          "direction": "vertical",
          "children": {
            "componentId": "place-item",
            "path": "/places"
          }
        },
        {
          "id": "place-item",
          "component": "Column",
          "children": ["place-name", "place-intro", "place-card", "place-description"]
        },
        {
          "id": "place-name",
          "component": "Text",
          "variant": "h3",
          "text": { "path": "name" }
        },
        {
          "id": "place-intro",
          "component": "Text",
          "variant": "body",
          "text": { "path": "intro" }
        },
        {
          "id": "place-card",
          "component": "PlaceDetailsCompact",
          "placeId": { "path": "placeId" }
        },
        {
          "id": "place-description",
          "component": "Text",
          "variant": "body",
          "text": { "path": "description" }
        }
      ]
    }
  },
  {
    "version": "v0.9",
    "updateDataModel": {
      "surfaceId": "{{surface_id}}",
      "path": "/",
      "value": {
        "places": "{{places}}"
      }
    }
  }
]
