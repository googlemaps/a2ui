[
  {
    "version": "v0.9",
    "createSurface": {
      "surfaceId": "{{surface_id}}",
      "catalogId": "a2ui://maps-agentic-ui-catalog.json"
    }
  },
  {
    "version": "v0.9",
    "updateComponents": {
      "surfaceId": "{{surface_id}}",
      "components": [
        {
          "id": "root",
          "component": "Column",
          "children": ["heading-text", "map", "summary-text"]
        },
        {
          "id": "heading-text",
          "component": "Text",
          "variant": "body",
          "text": "### {{heading}}"
        },
        {
          "id": "map",
          "component": "GoogleMap",
          "center": {
            "lat": "{{center_lat}}",
            "lng": "{{center_lng}}"
          },
          "zoom": "{{zoom}}",
          "routes": "{{routes}}",
          "travelMode": "{{travel_mode}}"
        },
        {
          "id": "summary-text",
          "component": "Text",
          "variant": "body",
          "text": "{{summary}}"
        }
      ]
    }
  },
  {
    "version": "v0.9",
    "updateDataModel": {
      "surfaceId": "{{surface_id}}",
      "path": "/",
      "value": {}
    }
  }
]
